# ------------------------------------------------------------
# G-Nesting — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Gere APP_KEY com: php bin/generate-key.php
# ------------------------------------------------------------

# Aplicação
# APP_ENV: local | testing | production
# APP_DEBUG: SEMPRE false em produção
APP_NAME="G-Nesting"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://gnesting.test
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gnesting
DB_USERNAME=root
DB_PASSWORD=

# Banco usado pelos testes de integração (é recriado a cada execução)
DB_TEST_DATABASE=gnesting_test

# Sessão (minutos). SESSION_SECURE_COOKIE=true em produção (HTTPS)
SESSION_NAME=gn_session
SESSION_LIFETIME=120
SESSION_ADMIN_ABSOLUTE_HOURS=12
SESSION_SECURE_COOKIE=false

# E-mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contato@gnesting.com.br
MAIL_FROM_NAME="G-Nesting"

# E-mail: log (grava em storage/logs/mail-*.log) | mail (função mail() da hospedagem)
MAIL_DRIVER=log

# Pagamento (docs/12-checkout.md)
# PAYMENT_PROVIDER: mercadopago | simulado (simulado NUNCA em produção)
PAYMENT_PROVIDER=simulado
# Mercado Pago → Suas integrações → Credenciais (Access Token) e Webhooks (assinatura secreta)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MAX_INSTALLMENTS=12
# Horas para pagar antes do cancelamento automático (cron)
PAYMENT_EXPIRY_HOURS=48

# Frete por tabela (config/shipping.php): UF de onde os pedidos saem
SHIPPING_PROVIDER=table
SHIPPING_ORIGIN_STATE=BA
# true = oferece "Retirada no ateliê"
SHIPPING_PICKUP=false

# Uploads (MB)
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_PRODUCTION_FILE_MB=20
