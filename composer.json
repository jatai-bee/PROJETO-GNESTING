{
    "name": "gnesting/store",
    "description": "G-Nesting — Objetos que transformam espaços. E-commerce de objetos produzidos por fabricação digital (CNC).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "nikic/fast-route": "^1.3",
        "symfony/yaml": "^7.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GNesting\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "GNesting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php bin/lint.php",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@audit-deps",
            "@test"
        ],
        "audit-deps": "@composer audit",
        "migrate": "@php database/migrate.php",
        "serve": "@php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts-descriptions": {
        "lint": "Verifica a sintaxe de todos os arquivos PHP do projeto",
        "analyse": "Análise estática (PHPStan, nível 6)",
        "check": "Tudo antes de publicar: sintaxe, análise estática, vulnerabilidades e testes",
        "audit-deps": "Vulnerabilidades conhecidas nas dependências"
    }
}
