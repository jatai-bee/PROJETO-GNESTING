# Dependências
/vendor/

# Ambiente e segredos
.env
.env.*
!.env.example

# Storage (mantém a estrutura, ignora o conteúdo)
/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/private/production_files/*
